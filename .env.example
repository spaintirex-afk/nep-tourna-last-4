# URL of the deployed Nep Tourna backend when the app is packaged with Capacitor.
# Example: https://api.example.com
# Leave empty when the frontend and API are served from the same origin.
VITE_API_URL=

# Optional: when using Capacitor to load an already-hosted web app instead of the bundled dist.
# CAP_SERVER_URL=https://app.example.com

# Production backend CORS origin(s), comma-separated.
# Example: https://app.example.com,capacitor://localhost,http://localhost
# CORS_ORIGINS=
